{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "penpot": {
      "type": "http",
      "url": "${PENPOT_MCP_URL:-http://localhost:4401/mcp}"
    },
    "inkscape": {
      "command": "uvx",
      "args": ["--from", "git+https://github.com/jjjsood/inkscape-mcp-server.git", "inkscape-mcp"],
      "env": {
        "INKSCAPE_MCP_WORKSPACE_ROOTS": "/home/ubuntu/Portafolio/design/logo"
      }
    }
  }
}

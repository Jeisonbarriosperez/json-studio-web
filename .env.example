# Copia este archivo como .env y llena los valores reales. El .env NUNCA se sube a git.
# Aquí solo van nombres de variables y valores de ejemplo falsos.

# --- Aplicación ---
NODE_ENV=development
# URL pública del sitio. En producción será el dominio real (https://...).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Payload CMS ---
# Firma las sesiones del panel. Genera uno largo y aleatorio: openssl rand -base64 32
PAYLOAD_SECRET=cambiar_por_un_valor_aleatorio_largo
# Protege la vista previa de borradores. Otro valor aleatorio distinto.
PREVIEW_SECRET=cambiar_por_otro_valor_aleatorio

# --- Base de datos: Neon, rama de desarrollo. Usa la cadena "pooled" (host con -pooler) ---
DATABASE_URL=postgresql://usuario:clave@ep-ejemplo-pooler.us-east-1.aws.neon.tech/jsonstudio?sslmode=require

# --- Correo (Resend). Sin dominio verificado solo puedes enviarte a tu propio correo
#     y el remitente debe ser onboarding@resend.dev ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=Json Studio <onboarding@resend.dev>
LEADS_NOTIFY_EMAIL=tu_correo@ejemplo.com

# --- Antispam (Cloudflare Turnstile). Estas son las claves de prueba oficiales:
#     siempre aprueban y sirven en local sin cuenta ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Archivos subidos: en local van a disco (public/media). Al desplegar, Cloudflare R2 ---
# R2_BUCKET=jsonstudio-media
# R2_ACCOUNT_ID=xxxxxxxxxxxxxxxx
# R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxx
# R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxx

# --- v2: pagos con Wompi (claves de sandbox) ---
# WOMPI_PUBLIC_KEY=pub_test_xxxxxxxx
# WOMPI_PRIVATE_KEY=prv_test_xxxxxxxx
# WOMPI_EVENTS_SECRET=test_events_xxxxxxxx
# WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxx
